{
  "name": "koon",
  "version": "1.0.0",
  "description": "Koon — chat desktop chiffre E2E avec seed phrase BIP39",
  "main": "dist-electron/main.js",
  "author": "Koon",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -p tsconfig.electron.json && tsc --noEmit && vite build && electron-builder",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build"
  },
  "dependencies": {
    "bip39": "3.1.0",
    "@noble/curves": "1.4.0",
    "tweetnacl": "1.0.3",
    "tweetnacl-util": "0.15.1",
    "better-sqlite3": "9.4.3",
    "zustand": "4.5.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "8.17.1"
  },
  "devDependencies": {
    "electron": "30.0.9",
    "electron-builder": "24.13.3",
    "vite": "5.3.1",
    "typescript": "5.5.2",
    "tailwindcss": "3.4.4",
    "postcss": "8.4.38",
    "autoprefixer": "10.4.19",
    "@vitejs/plugin-react": "4.3.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/better-sqlite3": "7.6.10",
    "@types/ws": "8.5.10",
    "@types/node": "20.14.9",
    "concurrently": "8.2.2",
    "wait-on": "7.2.0"
  },
  "build": {
    "appId": "com.koon.chat",
    "productName": "Koon",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "assets/**/*"],
    "win": { "target": "nsis", "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
